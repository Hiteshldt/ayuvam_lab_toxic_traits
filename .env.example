# Required for fast, reliable data. Free: data.gov.in → sign in → My Account → API key.
# Without it the site uses the public sample key, which is slow and often rate-limited.
DATA_GOV_API_KEY=

# Optional: AI-written roasts. Without it, hand-written roasts are used.
OPENROUTER_API_KEY=
# Free models are tried first; if they are rate-limited, the cheapest paid ones are used.
OPENROUTER_FREE_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free
OPENROUTER_MODELS=qwen/qwen3-30b-a3b-instruct-2507,mistralai/mistral-nemo,google/gemma-3-12b-it
DAILY_CAP=200

# Recommended in production: makes the cache and the daily cap global across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

SITE_URL=https://toxic-traits.vercel.app
SITE_NAME=Toxic Traits
